<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>Уход за кожей</title>
  <style>
    * { box-sizing: border-box; }

    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      font-family: system-ui, sans-serif;
      color: #392e33;
      background: #eadada;
    }

    .app {
      height: 100%;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      padding: max(8px, env(safe-area-inset-top)) 10px max(8px, env(safe-area-inset-bottom));
    }

    header {
      flex: 0 0 auto;
      text-align: center;
      padding: 3px 0 7px;
    }

    h1 {
      margin: 0;
      font-size: 20px;
    }

    .subtitle {
      margin: 2px 0 0;
      color: #76656b;
      font-size: 12px;
    }

    .stats {
      display: flex;
      justify-content: space-between;
      padding: 0 4px 7px;
      font-size: 13px;
      font-weight: 700;
    }

    .game {
      position: relative;
      flex: 1 1 auto;
      min-height: 180px;
      overflow: hidden;
      border-radius: 24px;
      background: linear-gradient(145deg, #f5e7e2, #e6c9c8);
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
    }

    footer {
      flex: 0 0 auto;
      min-height: 50px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding-top: 6px;
    }

    .message {
      margin: 0;
      color: #695a60;
      font-size: 12px;
      line-height: 1.3;
    }

    button {
      flex: 0 0 auto;
      border: 0;
      border-radius: 12px;
      padding: 9px 13px;
      color: #fff;
      background: #ad6686;
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <main class="app">
    <header>
      <h1>Уход за кожей</h1>
      <p class="subtitle">Поставьте два пальца по сторонам прыща и медленно сведите</p>
    </header>

    <div class="stats">
      <span id="person">Лицо 1 из 11</span>
      <span>Удалено: <span id="score">0</span></span>
    </div>

    <div class="game" id="game">
      <canvas id="canvas"></canvas>
    </div>

    <footer>
      <p class="message" id="message">Удерживайте два пальца и медленно сведите их.</p>
      <button id="restart" type="button">Заново</button>
    </footer>
  </main>

  <script>
    (() => {
      const canvas = document.getElementById("canvas");
      const ctx = canvas.getContext("2d");
      const game = document.getElementById("game");
      const message = document.getElementById("message");
      const scoreLabel = document.getElementById("score");
      const personLabel = document.getElementById("person");

      if (!ctx) {
        message.textContent = "Не удалось запустить игру в этом браузере.";
        return;
      }

      const people = [
        { skin: "#dba98e", hair: "#49342f", shirt: "#789b9b", eyes: "#514038", style: 0 },
        { skin: "#efc5a7", hair: "#67432f", shirt: "#af7899", eyes: "#493b36", style: 1 },
        { skin: "#a96f57", hair: "#29252c", shirt: "#687eaa", eyes: "#29262a", style: 2 },
        { skin: "#eac9b6", hair: "#956244", shirt: "#bd965f", eyes: "#5b443b", style: 0 },
        { skin: "#ca8c6d", hair: "#3c3036", shirt: "#75916e", eyes: "#392c32", style: 1 },
        { skin: "#f1d1b5", hair: "#b28a53", shirt: "#7594a9", eyes: "#4f6a70", style: 2 },
        { skin: "#87583f", hair: "#17191e", shirt: "#aa705a", eyes: "#302a26", style: 0 },
        { skin: "#e4b99d", hair: "#54454b", shirt: "#8374a6", eyes: "#514048", style: 1 },
        { skin: "#b8785c", hair: "#5a3024", shirt: "#6b9a83", eyes: "#443129", style: 2 },
        { skin: "#f2d6c3", hair: "#6a5040", shirt: "#c37b73", eyes: "#59443c", style: 0 },
        { skin: "#9d6653", hair: "#24252c", shirt: "#7388ae", eyes: "#28242a", style: 1 }
      ];

      const pointers = new Map();

      let W = 1;
      let H = 1;
      let dpr = 1;
      let personIndex = 0;
      let score = 0;
      let pimples = [];
      let stain = null;
      let stainLayer = document.createElement("canvas");
      let stainCtx = stainLayer.getContext("2d");
      let stainDirty = true;
      let wiping = false;
      let completed = false;
      let activeSqueeze = null;

      function randomBetween(min, max) {
        return min + Math.random() * (max - min);
      }

      function geometry() {
        const rx = Math.min(W * 0.455, H * 0.35);
        const ry = Math.min(H * 0.405, W * 0.59);

        return {
          cx: W / 2,
          cy: H * 0.46,
          rx: Math.max(30, rx),
          ry: Math.max(45, ry)
        };
      }

      function ellipse(x, y, rx, ry, fill, rotation = 0) {
        ctx.fillStyle = fill;
        ctx.beginPath();
        ctx.ellipse(x, y, rx, ry, rotation, 0, Math.PI * 2);
        ctx.fill();
      }

      function adjustColor(hex, amount) {
        const value = parseInt(hex.slice(1), 16);
        const r = Math.max(0, Math.min(255, (value >> 16) + amount));
        const g = Math.max(0, Math.min(255, ((value >> 8) & 255) + amount));
        const b = Math.max(0, Math.min(255, (value & 255) + amount));

        return `rgb(${r}, ${g}, ${b})`;
      }

      function createPimples() {
        const { cx, cy, rx, ry } = geometry();
        const spots = [
          [-0.48, -0.35],
          [0.45, -0.22],
          [-0.43, 0.22],
          [0.42, 0.36],
          [0.02, -0.08]
        ];

        pimples = [];

        for (let i = 0; i < 3; i++) {
          const [px, py] = spots[(i + personIndex) % spots.length];

          pimples.push({
            x: cx + rx * px,
            y: cy + ry * py,
            radius: Math.max(10, Math.min(15, W * 0.034)),
            state: "ready"
          });
        }
      }

      function drawFace() {
        const { cx, cy, rx, ry } = geometry();
        const person = people[personIndex];

        ctx.fillStyle = person.shirt;
        ctx.beginPath();
        ctx.ellipse(cx, H + ry * 0.18, rx * 1.55, ry * 0.64, 0, Math.PI, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = adjustColor(person.skin, -8);
        ctx.beginPath();
        ctx.moveTo(cx - rx * 0.23, cy + ry * 0.48);
        ctx.lineTo(cx + rx * 0.23, cy + ry * 0.48);
        ctx.lineTo(cx + rx * 0.23, cy + ry * 1.12);
        ctx.lineTo(cx - rx * 0.23, cy + ry * 1.12);
        ctx.closePath();
        ctx.fill();

        ellipse(cx, cy - ry * 0.22, rx * 1.1, ry * 0.98, person.hair);

        if (person.style === 1) {
          ellipse(cx - rx * 0.84, cy + ry * 0.15, rx * 0.25, ry * 0.66, person.hair, -0.12);
          ellipse(cx + rx * 0.84, cy + ry * 0.15, rx * 0.25, ry * 0.66, person.hair, 0.12);
        }

        ellipse(cx - rx * 0.93, cy + ry * 0.03, rx * 0.16, ry * 0.22, adjustColor(person.skin, -10));
        ellipse(cx + rx * 0.93, cy + ry * 0.03, rx * 0.16, ry * 0.22, adjustColor(person.skin, -10));

        const faceGradient = ctx.createRadialGradient(
          cx - rx * 0.3,
          cy - ry * 0.4,
          1,
          cx,
          cy,
          ry * 1.15
        );

        faceGradient.addColorStop(0, adjustColor(person.skin, 23));
        faceGradient.addColorStop(0.65, person.skin);
        faceGradient.addColorStop(1, adjustColor(person.skin, -22));

        ctx.fillStyle = faceGradient;
        ctx.beginPath();
        ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = person.hair;
        ctx.beginPath();
        ctx.moveTo(cx - rx, cy - ry * 0.43);
        ctx.quadraticCurveTo(cx - rx * 0.75, cy - ry * 1.08, cx - rx * 0.12, cy - ry * 0.92);
        ctx.quadraticCurveTo(cx + rx * 0.63, cy - ry * 1.05, cx + rx, cy - ry * 0.4);
        ctx.quadraticCurveTo(cx + rx * 0.48, cy - ry * 0.65, cx + rx * 0.12, cy - ry * 0.57);
        ctx.quadraticCurveTo(cx - rx * 0.3, cy - ry * 0.48, cx - rx, cy - ry * 0.43);
        ctx.closePath();
        ctx.fill();

        for (const side of [-1, 1]) {
          const ex = cx + rx * 0.36 * side;
          const ey = cy + ry * 0.03;

          ctx.strokeStyle = adjustColor(person.hair, -10);
          ctx.lineWidth = Math.max(2, W * 0.007);
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(ex - rx * 0.17, ey - ry * 0.13);
          ctx.quadraticCurveTo(ex, ey - ry * 0.2, ex + rx * 0.17, ey - ry * 0.13);
          ctx.stroke();

          ellipse(ex, ey, rx * 0.18, ry * 0.075, "#fff8f0");
          ellipse(ex, ey, rx * 0.065, ry * 0.065, person.eyes);
          ellipse(ex, ey, rx * 0.032, ry * 0.04, "#211b1e");
          ellipse(ex - rx * 0.018, ey - ry * 0.023, rx * 0.016, ry * 0.016, "#fff");
        }

        ctx.strokeStyle = "rgba(113, 67, 58, .55)";
        ctx.lineWidth = Math.max(1.7, W * 0.007);
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.moveTo(cx + rx * 0.02, cy + ry * 0.07);
        ctx.quadraticCurveTo(cx - rx * 0.07, cy + ry * 0.26, cx + rx * 0.02, cy + ry * 0.31);
        ctx.stroke();

        ellipse(cx - rx * 0.55, cy + ry * 0.25, rx * 0.19, ry * 0.09, "rgba(210, 100, 105, .12)");
        ellipse(cx + rx * 0.55, cy + ry * 0.25, rx * 0.19, ry * 0.09, "rgba(210, 100, 105, .12)");

        ctx.fillStyle = "#a85f6d";
        ctx.beginPath();
        ctx.moveTo(cx - rx * 0.2, cy + ry * 0.45);
        ctx.quadraticCurveTo(cx, cy + ry * 0.39, cx + rx * 0.2, cy + ry * 0.45);
        ctx.quadraticCurveTo(cx, cy + ry * 0.55, cx - rx * 0.2, cy + ry * 0.45);
        ctx.fill();
      }

      function drawPimple(pimple) {
        if (pimple.state !== "ready") return;

        const halo = ctx.createRadialGradient(
          pimple.x, pimple.y, 1,
          pimple.x, pimple.y, pimple.radius * 2.5
        );

        halo.addColorStop(0, "rgba(190, 50, 56, .25)");
        halo.addColorStop(1, "rgba(190, 50, 56, 0)");

        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(pimple.x, pimple.y, pimple.radius * 2.5, 0, Math.PI * 2);
        ctx.fill();

        const base = ctx.createRadialGradient(
          pimple.x - pimple.radius * 0.25,
          pimple.y - pimple.radius * 0.3,
          1,
          pimple.x,
          pimple.y,
          pimple.radius * 1.2
        );

        base.addColorStop(0, "#f49a8c");
        base.addColorStop(0.55, "#db5e5c");
        base.addColorStop(1, "#a9363e");

        ctx.fillStyle = base;
        ctx.beginPath();
        ctx.ellipse(
          pimple.x,
          pimple.y,
          pimple.radius,
          pimple.radius * 0.9,
          0,
          0,
          Math.PI * 2
        );
        ctx.fill();

        ellipse(
          pimple.x,
          pimple.y - pimple.radius * 0.12,
          pimple.radius * 0.48,
          pimple.radius * 0.4,
          "#fff4df"
        );
      }

      function drawRedness(pimple) {
        const radius = pimple.radius * 2.8;

        const redness = ctx.createRadialGradient(
          pimple.x, pimple.y, 1,
          pimple.x, pimple.y, radius
        );

        redness.addColorStop(0, "rgba(201, 55, 64, .40)");
        redness.addColorStop(0.45, "rgba(214, 83, 91, .22)");
        redness.addColorStop(1, "rgba(225, 108, 113, 0)");

        ctx.fillStyle = redness;
        ctx.beginPath();
        ctx.arc(pimple.x, pimple.y, radius, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "rgba(105, 43, 48, .58)";
        ctx.beginPath();
        ctx.arc(pimple.x, pimple.y, Math.max(1.5, pimple.radius * 0.14), 0, Math.PI * 2);
        ctx.fill();
      }

      function makeStain() {
        if (stain) return;

        const centerX = W * 0.5;
        const centerY = H * 0.51;
        const radiusX = W * 0.4;
        const radiusY = H * 0.32;
        const count = 32;
        const edge = [];

        for (let i = 0; i < count; i++) {
          const angle = (i / count) * Math.PI * 2;
          const wobble =
            1 +
            0.14 * Math.sin(angle * 3 + 0.7) +
            0.09 * Math.sin(angle * 5 - 1.1) +
            0.045 * Math.cos(angle * 7 + 0.4);

          edge.push({
            x: centerX + Math.cos(angle) * radiusX * wobble,
            y: centerY + Math.sin(angle) * radiusY * wobble
          });
        }

        stain = {
          centerX,
          centerY,
          radiusX,
          radiusY,
          edge,
          wiped: []
        };

        stainDirty = true;
      }

      function drawCloudStain(layerCtx) {
        if (!stain) return;

        layerCtx.clearRect(0, 0, W, H);
        layerCtx.save();

        const gradient = layerCtx.createRadialGradient(
          stain.centerX - stain.radiusX * 0.22,
          stain.centerY - stain.radiusY * 0.28,
          1,
          stain.centerX,
          stain.centerY,
          Math.max(stain.radiusX, stain.radiusY) * 1.12
        );

        gradient.addColorStop(0, "rgba(255, 255, 232, .80)");
        gradient.addColorStop(0.48, "rgba(255, 246, 177, .74)");
        gradient.addColorStop(0.82, "rgba(248, 222, 111, .67)");
        gradient.addColorStop(1, "rgba(242, 204, 90, .48)");

        layerCtx.fillStyle = gradient;
        layerCtx.beginPath();
        layerCtx.moveTo(stain.edge[0].x, stain.edge[0].y);

        for (let i = 0; i < stain.edge.length; i++) {
          const current = stain.edge[i];
          const next = stain.edge[(i + 1) % stain.edge.length];
          const midX = (current.x + next.x) / 2;
          const midY = (current.y + next.y) / 2;

          layerCtx.quadraticCurveTo(current.x, current.y, midX, midY);
        }

        layerCtx.closePath();
        layerCtx.fill();

        layerCtx.globalCompositeOperation = "destination-out";

        for (const mark of stain.wiped) {
          const wipe = layerCtx.createRadialGradient(
            mark.x, mark.y, mark.radius * 0.25,
            mark.x, mark.y, mark.radius
          );

          wipe.addColorStop(0, "rgba(0,0,0,1)");
          wipe.addColorStop(0.8, "rgba(0,0,0,.95)");
          wipe.addColorStop(1, "rgba(0,0,0,0)");

          layerCtx.fillStyle = wipe;
          layerCtx.beginPath();
          layerCtx.arc(mark.x, mark.y, mark.radius, 0, Math.PI * 2);
          layerCtx.fill();
        }

        layerCtx.restore();

        layerCtx.save();
        layerCtx.fillStyle = "rgba(91, 63, 48, .9)";
        layerCtx.font = `700 ${Math.max(13, W * 0.035)}px system-ui, sans-serif`;
        layerCtx.textAlign = "center";
        layerCtx.fillText("Проведите пальцем, чтобы протереть", W / 2, H * 0.11);
        layerCtx.restore();

        stainDirty = false;
      }

      function render() {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);

        drawFace();

        for (const pimple of pimples) {
          if (pimple.state === "ready") drawPimple(pimple);
          if (pimple.state === "gone") drawRedness(pimple);
        }

        if (stain) {
          if (stainDirty) {
            stainLayer.width = Math.round(W * dpr);
            stainLayer.height = Math.round(H * dpr);
            stainCtx = stainLayer.getContext("2d");
            stainCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
            drawCloudStain(stainCtx);
          }

          ctx.drawImage(stainLayer, 0, 0, W, H);
        }
      }

      function draw() {
        render();
      }

      function distance(a, b) {
        return Math.hypot(a.x - b.x, a.y - b.y);
      }

      function pointFromEvent(event) {
        const rect = canvas.getBoundingClientRect();

        return {
          x: (event.clientX - rect.left) * W / rect.width,
          y: (event.clientY - rect.top) * H / rect.height
        };
      }

      function addWipePoint(point) {
        stain.wiped.push({
          x: point.x,
          y: point.y,
          radius: Math.max(24, W * 0.07)
        });

        stainDirty = true;
      }

      function addWipeSegment(from, to) {
        const length = distance(from, to);
        const step = Math.max(8, W * 0.02);
        const steps = Math.max(1, Math.ceil(length / step));

        for (let i = 1; i <= steps; i++) {
          const t = i / steps;

          addWipePoint({
            x: from.x + (to.x - from.x) * t,
            y: from.y + (to.y - from.y) * t
          });
        }
      }

      function isStainCleared() {
        if (!stain) return false;

        const checks = 32;
        let cleared = 0;

        for (let i = 0; i < checks; i++) {
          const angle = (i / checks) * Math.PI * 2;
          const point = {
            x: stain.centerX + Math.cos(angle) * stain.radiusX * 0.48,
            y: stain.centerY + Math.sin(angle) * stain.radiusY * 0.4
          };

          if (stain.wiped.some(mark => distance(point, mark) < mark.radius)) {
            cleared++;
          }
        }

        return cleared / checks > 0.72;
      }

      function allPimplesGone() {
        return pimples.length > 0 && pimples.every(p => p.state === "gone");
      }

      function goToNextFace() {
        if (!allPimplesGone() || stain || completed) return;

        if (personIndex >= people.length - 1) {
          completed = true;
          personLabel.textContent = "Все лица очищены";
          message.textContent = `Готово! Удалено прыщей: ${score}.`;
          draw();
          return;
        }

        personIndex++;
        personLabel.textContent = `Лицо ${personIndex + 1} из ${people.length}`;
        createPimples();
        message.textContent = "Поставьте два пальца по сторонам прыща и медленно сведите.";
        draw();
      }

      function finishWiping() {
        stain = null;
        stainDirty = true;
        wiping = false;
        message.textContent = "Пятно убрано!";

        if (allPimplesGone()) {
          setTimeout(goToNextFace, 400);
        }

        draw();
      }

      function finishPimple(pimple) {
        if (pimple.state !== "ready") return;

        pimple.state = "gone";
        pimple.removedAt = Date.now();

        score++;
        scoreLabel.textContent = String(score);

        if (!stain && Math.random() < 0.25) {
          makeStain();
          message.textContent = "Проведите пальцем по пятну, чтобы стереть его.";
        } else if (allPimplesGone()) {
          message.textContent = "Все прыщи удалены!";

          setTimeout(() => {
            if (!stain) goToNextFace();
          }, 750);
        } else {
          message.textContent = "Прыщ удалён. Продолжайте.";
        }

        draw();
      }

      function tryStartSqueeze() {
        if (stain || completed || activeSqueeze || pointers.size !== 2) return;

        const entries = [...pointers.entries()];
        const first = entries[0][1];
        const second = entries[1][1];
        const midpoint = {
          x: (first.x + second.x) / 2,
          y: (first.y + second.y) / 2
        };

        const pimple = pimples.find(
          item => item.state === "ready" && distance(midpoint, item) < item.radius * 8
        );

        if (!pimple) {
          message.textContent = "Поставьте по одному пальцу с каждой стороны красного прыща.";
          return;
        }

        const initialDistance = distance(first, second);

        activeSqueeze = {
          pimple,
          ids: [entries[0][0], entries[1][0]],
          startDistance: initialDistance,
          lastDistance: initialDistance,
          totalClosing: 0,
          startedAt: performance.now()
        };

        message.textContent = "Медленно сводите пальцы. На это нужно не менее 1,5 секунды.";
      }

      function onDown(event) {
        event.preventDefault();

        try {
          game.setPointerCapture(event.pointerId);
        } catch (_) {}

        pointers.set(event.pointerId, pointFromEvent(event));

        if (stain) {
          wiping = true;
          addWipePoint(pointers.get(event.pointerId));
          draw();
          return;
        }

        if (pointers.size === 2) {
          tryStartSqueeze();
        }
      }

      function onMove(event) {
        if (!pointers.has(event.pointerId)) return;

        event.preventDefault();

        const previous = pointers.get(event.pointerId);
        const current = pointFromEvent(event);
        pointers.set(event.pointerId, current);

        if (stain && wiping) {
          addWipeSegment(previous, current);
          draw();

          if (isStainCleared()) {
            finishWiping();
          }

          return;
        }

        if (!activeSqueeze) {
          draw();
          return;
        }

        const squeeze = activeSqueeze;
        const first = pointers.get(squeeze.ids[0]);
        const second = pointers.get(squeeze.ids[1]);

        if (!first || !second) return;

        const currentDistance = distance(first, second);
        const closing = squeeze.lastDistance - currentDistance;

        if (closing > 0) {
          squeeze.totalClosing += closing;
        }

        squeeze.lastDistance = currentDistance;

        const elapsed = performance.now() - squeeze.startedAt;
        const pimple = squeeze.pimple;

        // Требуем заметного сближения и минимум 1,5 секунды удержания.
        const movedEnough = squeeze.totalClosing >= pimple.radius * 0.8;
        const heldLongEnough = elapsed >= 1500;

        if (movedEnough && heldLongEnough) {
          activeSqueeze = null;
          pointers.clear();
          finishPimple(pimple);
          return;
        }

        draw();
      }

      function onUp(event) {
        pointers.delete(event.pointerId);

        if (activeSqueeze && activeSqueeze.ids.includes(event.pointerId)) {
          activeSqueeze = null;
          message.textContent = "Попробуйте ещё раз: удерживайте оба пальца и медленно сведите их.";
        }

        if (pointers.size === 0) {
          wiping = false;
        }
      }

      function resize() {
        const rect = game.getBoundingClientRect();

        if (rect.width < 1 || rect.height < 1) {
          requestAnimationFrame(resize);
          return;
        }

        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = rect.width;
        H = rect.height;

        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        canvas.style.width = `${W}px`;
        canvas.style.height = `${H}px`;

        stainLayer.width = Math.round(W * dpr);
        stainLayer.height = Math.round(H * dpr);
        stainCtx = stainLayer.getContext("2d");

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        createPimples();

        // При изменении размера пересоздаём пятно с новыми координатами.
        if (stain) {
          stain = null;
          stainDirty = true;
        }

        activeSqueeze = null;
        pointers.clear();
        draw();
      }

      game.addEventListener("pointerdown", onDown);
      game.addEventListener("pointermove", onMove);
      game.addEventListener("pointerup", onUp);
      game.addEventListener("pointercancel", onUp);

      document.getElementById("restart").addEventListener("click", () => {
        personIndex = 0;
        score = 0;
        stain = null;
        wiping = false;
        completed = false;
        activeSqueeze = null;
        pointers.clear();

        scoreLabel.textContent = "0";
        personLabel.textContent = `Лицо 1 из ${people.length}`;
        message.textContent = "Удерживайте два пальца и медленно сведите их.";

        createPimples();
        draw();
      });

      if ("ResizeObserver" in window) {
        new ResizeObserver(resize).observe(game);
      } else {
        window.addEventListener("resize", resize);
      }

      requestAnimationFrame(resize);
    })();
  </script>
</body>
</html>